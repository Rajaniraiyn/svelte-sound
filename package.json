{
  "name": "svelte-sound",
  "version": "1.0.0",
  "description": "Reactive sound effects with Svelte-owned lifecycles.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./renderer": {
      "types": "./dist/renderer.d.ts",
      "svelte": "./dist/renderer.js",
      "default": "./dist/renderer.js"
    },
    "./web-audio": {
      "types": "./dist/web-audio.d.ts",
      "default": "./dist/web-audio.js"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "bun run --filter example-svelte dev",
    "build": "bun --bun svelte-package -i src -o dist",
    "check": "bun --bun svelte-check --tsconfig tsconfig.json && bun run --filter example-sveltekit check",
    "lint": "bun --bun oxlint --deny-warnings && bun fmt --check",
    "format": "bun fmt",
    "test": "bun test",
    "test:browser": "bun test ./tests/browser.test.ts",
    "validate": "bun run lint && bun run check && bun test && bun run build",
    "prepublishOnly": "bun run validate",
    "dev:kit": "bun run --filter example-sveltekit dev",
    "dev:renderer": "bun run --filter example-renderer dev",
    "build:examples": "bun run --filter \"example-*\" build"
  },
  "author": "Rajaniraiyn R <rajaniraiyn@gmail.com>",
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.2",
    "svelte": "^5.59.2",
    "svelte-check": "^4.7.8",
    "typescript": "~6.0.3",
    "vite": "^8.4.0",
    "oxlint": "^1.95.0",
    "@types/bun": "^1.4.0",
    "@sveltejs/package": "^3.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rajaniraiyn/svelte-sound.git"
  },
  "keywords": [
    "svelte",
    "sound",
    "audio",
    "web-audio",
    "attachments"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Rajaniraiyn/svelte-sound/issues"
  },
  "homepage": "https://github.com/Rajaniraiyn/svelte-sound#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "svelte": "./dist/index.js",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "MIGRATION.md",
    "docs"
  ],
  "packageManager": "bun@1.4.5",
  "peerDependencies": {
    "svelte": "^5.29.0"
  },
  "workspaces": [
    "examples/*"
  ]
}
