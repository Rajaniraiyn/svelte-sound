{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["bun", "vite/client"],
    "paths": {
      "svelte-sound": ["./src/index.ts"],
      "svelte-sound/renderer": ["./src/renderer.ts"],
      "svelte-sound/web-audio": ["./src/web-audio.ts"]
    },
    "allowJs": true,
    "checkJs": true
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "tests/**/*.svelte",
    "examples/svelte/**/*.ts",
    "examples/svelte/**/*.svelte",
    "examples/renderer/**/*.ts",
    "examples/renderer/**/*.svelte",
    "examples/vite.ts"
  ]
}
